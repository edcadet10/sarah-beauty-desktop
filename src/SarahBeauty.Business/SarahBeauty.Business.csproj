<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Google.Apis.Auth" Version="1.78.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <InternalsVisibleTo Include="SarahBeauty.Storage.Tests" />
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../.artifacts/recovery-helper/SarahBeauty.Recovery.exe" Link="SarahBeauty.Recovery.exe"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('../../.artifacts/recovery-helper/SarahBeauty.Recovery.exe')" />
    <Content Include="../../.artifacts/recovery-helper/ThirdParty/*" Link="ThirdParty/Recovery/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../docs/third-party/pdfsharp-6.2.4-license.txt" Link="ThirdParty/PDFsharp/LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../docs/third-party/dotnet-runtime-10.0.15-license.txt" Link="ThirdParty/DotNet/LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)system.security.cryptography.protecteddata/10.0.15/THIRD-PARTY-NOTICES.TXT" Link="ThirdParty/DotNet/ProtectedData-NOTICES.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../docs/third-party/google-api-dotnet-client-1.78.0-license.txt" Link="ThirdParty/GoogleApis/LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../docs/third-party/google-api-dotnet-client-1.78.0-credits.txt" Link="ThirdParty/GoogleApis/CREDITS.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)newtonsoft.json/13.0.4/LICENSE.md" Link="ThirdParty/GoogleApis/NewtonsoftJson-LICENSE.md"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)system.management/7.0.2/LICENSE.TXT" Link="ThirdParty/GoogleApis/SystemManagement-LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)system.management/7.0.2/THIRD-PARTY-NOTICES.TXT" Link="ThirdParty/GoogleApis/SystemManagement-NOTICES.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)system.codedom/7.0.0/LICENSE.TXT" Link="ThirdParty/GoogleApis/SystemCodeDom-LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)system.codedom/7.0.0/THIRD-PARTY-NOTICES.TXT" Link="ThirdParty/GoogleApis/SystemCodeDom-NOTICES.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
