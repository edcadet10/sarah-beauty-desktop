<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SarahBeauty_Desktop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SarahBeauty_Desktop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        This is the main content area of your application.
        Add your UI elements here — for example, controls, layouts, and data-bound views.
        Use 'dotnet new winui-page' to create additional pages and navigate to them via
        the Frame in MainWindow (RootFrame).
    -->
    <Grid Padding="32">
        <StackPanel Spacing="12">
            <TextBlock
                Text="Sarah Beauty"
                FontSize="32"
                FontWeight="SemiBold" />

            <TextBlock
                Text="Business Management"
                FontSize="18" />    

            <TextBlock
                Text="Development preview - no business records yet."
                TextWrapping="Wrap" />

            <TextBlock
                Text="TEST database"
                FontWeight="SemiBold" />

            <TextBlock
                x:Name="StoragePathText"
                TextWrapping="Wrap"
                IsTextSelectionEnabled="True" />

        </StackPanel>
    </Grid>
</Page>
