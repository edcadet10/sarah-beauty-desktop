<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="SarahCanvasBrush" Color="#FAF7F4" />
            <SolidColorBrush x:Key="SarahSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SarahSoftBrush" Color="#F0E2E8" />
            <SolidColorBrush x:Key="SarahTextBrush" Color="#2D2430" />
            <SolidColorBrush x:Key="SarahMutedBrush" Color="#6C5B67" />
            <SolidColorBrush x:Key="SarahAccentBrush" Color="#633F59" />
            <SolidColorBrush x:Key="SarahStrokeBrush" Color="#D9CBD2" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#633F59" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#52314A" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#43263B" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#633F59" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#52314A" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#43263B" />
            <StaticResource x:Key="AccentButtonBackground" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="AccentFillColorSecondaryBrush" />
            <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="AccentFillColorTertiaryBrush" />
            <StaticResource x:Key="AccentButtonForeground" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
            <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
            <StaticResource x:Key="AccentButtonForegroundPressed" ResourceKey="TextOnAccentFillColorSecondaryBrush" />
            <StaticResource x:Key="NavigationViewSelectionIndicatorForeground" ResourceKey="SarahAccentBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="SarahCanvasBrush" Color="#1F1A21" />
            <SolidColorBrush x:Key="SarahSurfaceBrush" Color="#2C2430" />
            <SolidColorBrush x:Key="SarahSoftBrush" Color="#40313E" />
            <SolidColorBrush x:Key="SarahTextBrush" Color="#F7EFF5" />
            <SolidColorBrush x:Key="SarahMutedBrush" Color="#CFBDC9" />
            <SolidColorBrush x:Key="SarahAccentBrush" Color="#E6A9CC" />
            <SolidColorBrush x:Key="SarahStrokeBrush" Color="#665360" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#E6A9CC" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#F0BFDB" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#D99ABD" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#1F1A21" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#1F1A21" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#E6A9CC" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#F0BFDB" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#D99ABD" />
            <StaticResource x:Key="AccentButtonBackground" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="AccentFillColorSecondaryBrush" />
            <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="AccentFillColorTertiaryBrush" />
            <StaticResource x:Key="AccentButtonForeground" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
            <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
            <StaticResource x:Key="AccentButtonForegroundPressed" ResourceKey="TextOnAccentFillColorSecondaryBrush" />
            <StaticResource x:Key="NavigationViewSelectionIndicatorForeground" ResourceKey="SarahAccentBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="SarahCanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SarahSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SarahSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SarahTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SarahMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SarahAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SarahStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <Style x:Key="SarahTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource SarahTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SarahBodyStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{ThemeResource SarahTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SarahMutedStyle" TargetType="TextBlock" BasedOn="{StaticResource SarahBodyStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SarahMutedBrush}" />
    </Style>
    <Style x:Key="SarahCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SarahSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SarahStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20" />
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
</ResourceDictionary>
