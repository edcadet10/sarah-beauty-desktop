<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ChartBlueBrush" Color="#326E88" />
            <SolidColorBrush x:Key="ChartPurpleBrush" Color="#765C8A" />
            <SolidColorBrush x:Key="SarahGoldBrush" Color="#86682A" />
            <SolidColorBrush x:Key="SarahCanvasBrush" Color="#FBF8F0" />
            <SolidColorBrush x:Key="SarahSurfaceBrush" Color="#FFFEFA" />
            <SolidColorBrush x:Key="SarahSoftBrush" Color="#EEE6D4" />
            <SolidColorBrush x:Key="SarahTextBrush" Color="#22372D" />
            <SolidColorBrush x:Key="SarahMutedBrush" Color="#56665A" />
            <SolidColorBrush x:Key="SarahAccentBrush" Color="#174E3C" />
            <SolidColorBrush x:Key="SarahStrokeBrush" Color="#D6CBB5" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#174E3C" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#103D2F" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#0B3025" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFEFA" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#FFFEFA" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#174E3C" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#103D2F" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#0B3025" />
            <StaticResource x:Key="AccentButtonBackground" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="AccentFillColorSecondaryBrush" />
            <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="AccentFillColorTertiaryBrush" />
            <StaticResource x:Key="AccentButtonForeground" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
            <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
            <StaticResource x:Key="AccentButtonForegroundPressed" ResourceKey="TextOnAccentFillColorSecondaryBrush" />
            <StaticResource x:Key="NavigationViewSelectionIndicatorForeground" ResourceKey="SarahAccentBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ChartBlueBrush" Color="#88BDD1" />
            <SolidColorBrush x:Key="ChartPurpleBrush" Color="#CAB0DF" />
            <SolidColorBrush x:Key="SarahGoldBrush" Color="#D8BE82" />
            <SolidColorBrush x:Key="SarahCanvasBrush" Color="#14251F" />
            <SolidColorBrush x:Key="SarahSurfaceBrush" Color="#1C3229" />
            <SolidColorBrush x:Key="SarahSoftBrush" Color="#314036" />
            <SolidColorBrush x:Key="SarahTextBrush" Color="#F8F4E8" />
            <SolidColorBrush x:Key="SarahMutedBrush" Color="#C4CFBE" />
            <SolidColorBrush x:Key="SarahAccentBrush" Color="#9FD7B4" />
            <SolidColorBrush x:Key="SarahStrokeBrush" Color="#5F725D" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#9FD7B4" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#B4E4C4" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#8DC7A2" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#14251F" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#14251F" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#9FD7B4" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#B4E4C4" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#8DC7A2" />
            <StaticResource x:Key="AccentButtonBackground" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="AccentFillColorSecondaryBrush" />
            <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="AccentFillColorTertiaryBrush" />
            <StaticResource x:Key="AccentButtonForeground" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
            <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
            <StaticResource x:Key="AccentButtonForegroundPressed" ResourceKey="TextOnAccentFillColorSecondaryBrush" />
            <StaticResource x:Key="NavigationViewSelectionIndicatorForeground" ResourceKey="SarahAccentBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="ChartBlueBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ChartPurpleBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SarahGoldBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SarahCanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SarahSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SarahSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SarahTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SarahMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SarahAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SarahStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <Style x:Key="SarahTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource SarahTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SarahBodyStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{ThemeResource SarahTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SarahMutedStyle" TargetType="TextBlock" BasedOn="{StaticResource SarahBodyStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SarahMutedBrush}" />
    </Style>
    <Style x:Key="SarahCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SarahSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SarahStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20" />
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
</ResourceDictionary>
