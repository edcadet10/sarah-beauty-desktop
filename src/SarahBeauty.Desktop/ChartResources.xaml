<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="ChartEmeraldShapeStyle" TargetType="Shape">
        <Setter Property="Fill" Value="{ThemeResource SarahAccentBrush}" />
        <Setter Property="Stroke" Value="{ThemeResource SarahAccentBrush}" />
    </Style>
    <Style x:Key="ChartGoldShapeStyle" TargetType="Shape">
        <Setter Property="Fill" Value="{ThemeResource SarahGoldBrush}" />
        <Setter Property="Stroke" Value="{ThemeResource SarahGoldBrush}" />
    </Style>
    <Style x:Key="ChartBlueShapeStyle" TargetType="Shape">
        <Setter Property="Fill" Value="{ThemeResource ChartBlueBrush}" />
        <Setter Property="Stroke" Value="{ThemeResource ChartBlueBrush}" />
    </Style>
    <Style x:Key="ChartPurpleShapeStyle" TargetType="Shape">
        <Setter Property="Fill" Value="{ThemeResource ChartPurpleBrush}" />
        <Setter Property="Stroke" Value="{ThemeResource ChartPurpleBrush}" />
    </Style>
    <Style x:Key="ChartAxisShapeStyle" TargetType="Shape">
        <Setter Property="Stroke" Value="{ThemeResource SarahMutedBrush}" />
    </Style>
</ResourceDictionary>
